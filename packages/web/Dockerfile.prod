# syntax=docker/dockerfile:1.7

# Stage 1: deps — instala dependencias del monorepo.
# Necesita las devDependencies (vite, typescript, @vitejs/plugin-react) para compilar.
# El peso de esta etapa no afecta la imagen final: es descartada por el multi-stage.
FROM node:22-alpine AS deps
WORKDIR /app
ENV NPM_CONFIG_AUDIT=false NPM_CONFIG_FUND=false NPM_CONFIG_UPDATE_NOTIFIER=false

COPY package*.json ./
COPY packages/web/package*.json ./packages/web/
COPY packages/shared/package*.json ./packages/shared/

RUN npm ci --ignore-scripts

# Stage 2: build — compila la SPA con Vite (genera estáticos en packages/web/dist).
FROM node:22-alpine AS build
WORKDIR /app
ENV NPM_CONFIG_AUDIT=false NPM_CONFIG_FUND=false NPM_CONFIG_UPDATE_NOTIFIER=false

COPY --from=deps /app/node_modules ./node_modules
COPY package*.json ./
COPY packages/web ./packages/web
COPY packages/shared ./packages/shared

# URL de la API horneada en build-time por Vite (la usa el navegador del cliente).
# Si no se pasa, el código cae a http://localhost:3000 (ver packages/web/src/services/*).
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Compilamos con `vite build` directo (sin `tsc -b`) para que un error de tipos no
# rompa la imagen de producción; el type-check corre en el CI. Sin `|| true`: si el
# build falla, la imagen debe fallar de forma explícita.
RUN cd packages/web && npx vite build

# Stage 3: runtime — nginx unprivileged (uid 101, escucha en :8080).
# Compatible con read_only + cap_drop: ALL del docker-compose.prod.yml.
FROM nginxinc/nginx-unprivileged:stable-alpine AS runtime

# Config propia: SPA fallback (react-router), gzip, cache de assets y security headers.
# Reemplaza solo el server block; el nginx.conf base del unprivileged ya deja pid y
# rutas temporales en /tmp, necesario para correr con filesystem de solo lectura.
COPY packages/web/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/packages/web/dist /usr/share/nginx/html

EXPOSE 8080

# 127.0.0.1 (no localhost): dentro del contenedor localhost resuelve a ::1 (IPv6)
# y nginx escucha en IPv4, lo que daría "connection refused" en el healthcheck.
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
