# syntax=docker/dockerfile:1.7

# Stage 1: build — compila TypeScript y genera el cliente de Prisma
FROM node:22-alpine AS build
WORKDIR /app
ENV NPM_CONFIG_AUDIT=false NPM_CONFIG_FUND=false NPM_CONFIG_UPDATE_NOTIFIER=false

COPY package*.json ./
COPY packages/api/package*.json ./packages/api/
COPY packages/shared/package*.json ./packages/shared/

# Solo los workspaces que el API necesita (deja afuera a "web" y sus deps)
RUN npm ci --ignore-scripts \
    --workspace=@alentapp/api \
    --workspace=@alentapp/shared \
    --include-workspace-root=false

COPY packages/api ./packages/api
COPY packages/shared ./packages/shared
COPY tsconfig.json ./

RUN npx prisma generate --config packages/api/prisma.config.ts \
 && (cd packages/shared && npx tsc --outDir dist --declaration || true) \
 && (cd packages/api && npx tsc || true)

# Stage 2: deps-prod — node_modules sin dev deps, acotado al workspace del API
# Mantiene el CLI de Prisma porque la API corre `migrate deploy` al arrancar.
FROM node:22-alpine AS deps-prod
WORKDIR /app
ENV NPM_CONFIG_AUDIT=false NPM_CONFIG_FUND=false NPM_CONFIG_UPDATE_NOTIFIER=false

COPY package*.json ./
COPY packages/api/package*.json ./packages/api/
COPY packages/shared/package*.json ./packages/shared/

RUN npm ci --omit=dev --ignore-scripts \
    --workspace=@alentapp/api \
    --workspace=@alentapp/shared \
    --include-workspace-root=false \
 && npm cache clean --force \
 # Prisma 7 CLI requiere @prisma/dev + @electric-sql incluso para `migrate deploy`
 # Hoisteados de "web" o tooling — NO los importan ni la API ni el CLI de Prisma
 # (NO borrar: valibot, remeda, fast-check, effect, @electric-sql, @prisma/dev — los exige @prisma CLI)
 && rm -rf \
      node_modules/react \
      node_modules/react-dom \
      node_modules/react-is \
      node_modules/chart.js \
      node_modules/hono \
      node_modules/typescript \
      node_modules/csstype \
      node_modules/@types \
 # Limpieza de archivos no necesarios en runtime
 && find node_modules -type d \( -name test -o -name tests -o -name __tests__ -o -name docs -o -name examples \) -prune -exec rm -rf {} + 2>/dev/null || true \
 && find node_modules -type f \( -name "*.md" -o -name "*.markdown" -o -name "*.map" -o -name "*.ts" -o -name "LICENSE*" -o -name "CHANGELOG*" -o -name ".npmignore" -o -name ".eslintrc*" -o -name "tsconfig*.json" \) -delete 2>/dev/null || true

# Stage 3: runtime — imagen final, corre migraciones y luego el servidor
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000

COPY --chown=node:node --from=deps-prod /app/node_modules ./node_modules
# Las engines binarias de Prisma se descargan vía postinstall (que skipeamos con --ignore-scripts).
# Las traemos del stage `build`, donde `prisma generate` ya las descargó.
COPY --chown=node:node --from=build /app/node_modules/@prisma/engines ./node_modules/@prisma/engines
COPY --chown=node:node --from=build /app/packages/api/dist ./packages/api/dist
COPY --chown=node:node --from=build /app/packages/api/src/generated ./packages/api/dist/generated
COPY --chown=node:node --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --chown=node:node packages/api/package.json ./packages/api/
COPY --chown=node:node packages/shared/package.json ./packages/shared/
COPY --chown=node:node packages/api/prisma ./packages/api/prisma
COPY --chown=node:node packages/api/prisma.config.ts ./packages/api/

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ || exit 1

# Corre migraciones y luego inicia el servidor.
# Llamamos al binario de Prisma directo (sin npx) para que `read_only: true` no requiera
# tmpfs en /home/node/.npm (npx escribiría ahí su cache).
CMD ["sh", "-c", "cd /app/packages/api && node /app/node_modules/prisma/build/index.js migrate deploy --config prisma.config.ts && cd /app && node packages/api/dist/server.js"]
