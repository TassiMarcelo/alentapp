# Variables de entorno para docker-compose.prod.yml
# Copiá este archivo a `.env` y completá los valores reales.
#   cp .env.example .env

# --- PostgreSQL (servicio db) ---
POSTGRES_USER=alentapp
POSTGRES_PASSWORD=cambiame_por_una_clave_segura
POSTGRES_DB=alentapp

# --- API (servicio api) ---
# El host debe ser `db` (nombre del servicio en la red interna), no localhost.
# Debe coincidir con POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB de arriba.
DATABASE_URL=postgresql://alentapp:cambiame_por_una_clave_segura@db:5432/alentapp

# --- Frontend (servicio web) ---
# NO lo lee el compose: es un build-arg que se hornea al construir la imagen del web.
#   docker build -f packages/web/Dockerfile.prod --build-arg VITE_API_URL=$VITE_API_URL -t alentapp-web:prod .
# URL pública donde el navegador del cliente alcanza la API.
VITE_API_URL=http://localhost:3000

# --- Grafana (servicio grafana) ---
# Credenciales del usuario admin de Grafana (http://localhost:3001).
# Si no se setean, el compose usa admin/admin por defecto.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiame_por_una_clave_segura
